// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipment {
  id            String   @id @default(cuid())
  category      String   // "Trucks" | "Vans" | "Mowers" | "Tractors" | "Handhelds"
  year          Int?
  make          String
  model         String
  trim          String?
  stockNumber   String?
  serialNumber  String? // VIN for trucks/vans, serial number for equipment
  hours         Int? // engine hours (mowers/tractors)
  mileage       Int? // odometer miles (trucks/vans)
  condition     String   @default("New") // "New" | "Used"
  color         String?
  transmission  String?
  driveType     String?
  fuelType      String?
  engine        String?
  description   String?

  cashPrice     Int // whole dollars
  financePrice  Int? // whole dollars, null = finance not offered on this unit
  monthlyPrice  Int? // whole dollars/month, shown as "Starting at $X/mo" on listings

  status        String   @default("available") // "available" | "pending" | "sold"
  featured      Boolean  @default(false)

  photos        Photo[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([category])
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  order       Int       @default(0)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
